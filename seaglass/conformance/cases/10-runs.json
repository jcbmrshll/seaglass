[
  {
    "name": "a run created with nothing gets defaults",
    "steps": [
      {"request": {"method": "POST", "path": "/api/runs", "json": {}},
       "response": {"status": 201, "headers": {"Content-Type": {"$regex": "^application/json"}},
                    "json": {"$exact": {
                      "id": {"$regex": "^\\d{8}-\\d{6}-[0-9a-f]{4}$", "$capture": "run"},
                      "project": "default",
                      "name": {"$type": "string", "$regex": "."},
                      "created": {"$type": "number", "$capture": "created"},
                      "updated": {"$gte": "created"},
                      "status": "running",
                      "step": null,
                      "total": null,
                      "latest": {},
                      "activity": null,
                      "activity_since": null,
                      "tags": [],
                      "provenance": {},
                      "bundle": null,
                      "config": {}
                    }}}},
      {"request": {"method": "GET", "path": "/api/runs/{{run}}"},
       "response": {"status": 200, "json": {"id": {"$var": "run"}, "project": "default", "status": "running", "config": {}}}}
    ]
  },
  {
    "name": "a run keeps what it was created with",
    "steps": [
      {"request": {"method": "POST", "path": "/api/runs", "json": {
         "project": "conformance", "name": "run {{nonce}}",
         "config": {"lr": 0.0003, "net": {"layers": [64, 64]}, "fn": "relu"},
         "tags": ["sweep-3", "conformance"],
         "provenance": {"git": {"commit": "abc123", "branch": "dev", "dirty": false}, "host": "gpu-box", "argv": ["train.py"], "cwd": "/work"},
         "total": 300}},
       "response": {"status": 201, "json": {
         "id": {"$capture": "run"}, "project": "conformance", "name": "run {{nonce}}",
         "config": {"$exact": {"lr": 0.0003, "net": {"layers": [64, 64]}, "fn": "relu"}},
         "tags": ["sweep-3", "conformance"],
         "provenance": {"$exact": {"git": {"commit": "abc123", "branch": "dev", "dirty": false}, "host": "gpu-box", "argv": ["train.py"], "cwd": "/work"}},
         "total": 300}}},
      {"request": {"method": "GET", "path": "/api/runs/{{run}}"},
       "response": {"status": 200, "json": {"name": "run {{nonce}}", "tags": ["sweep-3", "conformance"], "total": 300, "config": {"net": {"layers": [64, 64]}}}}}
    ]
  },
  {
    "name": "the run list has every run, without its config",
    "steps": [
      {"request": {"method": "POST", "path": "/api/runs", "json": {"project": "conformance", "config": {"secret": 1}}},
       "response": {"status": 201, "json": {"id": {"$capture": "run"}}}},
      {"request": {"method": "GET", "path": "/api/runs"},
       "response": {"status": 200, "headers": {"Access-Control-Allow-Origin": "*"},
                    "json": {"$contains": [{"id": {"$var": "run"}, "project": "conformance", "status": "running", "config": {"$absent": true}, "latest": {}}]}}}
    ]
  },
  {
    "name": "invalid runs are refused",
    "steps": [
      {"request": {"method": "POST", "path": "/api/runs", "json": {"project": "has spaces"}},
       "response": {"status": 400, "json": {"error": {"$type": "string"}}}},
      {"request": {"method": "POST", "path": "/api/runs", "json": {"tags": ["a,b"]}},
       "response": {"status": 400, "json": {"error": {"$type": "string"}}}},
      {"request": {"method": "POST", "path": "/api/runs", "json": {"tags": [" padded"]}},
       "response": {"status": 400}},
      {"request": {"method": "POST", "path": "/api/runs", "json": {"bundle": "not-a-hash"}},
       "response": {"status": 400}},
      {"request": {"method": "POST", "path": "/api/runs", "json": {"config": [1, 2]}},
       "response": {"status": 400}},
      {"request": {"method": "POST", "path": "/api/runs", "json": {"total": 2.5}},
       "response": {"status": 400}},
      {"request": {"method": "POST", "path": "/api/runs", "json": [1]},
       "response": {"status": 400}},
      {"request": {"method": "POST", "path": "/api/runs", "text": "{not json", "headers": {"Content-Type": "application/json"}},
       "response": {"status": 400, "json": {"error": {"$type": "string"}}}}
    ]
  }
]
